form="rotate(-28 390 305)"/><ellipse cx="410" cy="300" rx="14" ry="6" transform="rotate(38 410 300)"/></g></svg>') no-repeat;
            background-size: contain;
            pointer-events: none;
        }

        .cover::after {
            content: '';
            position: absolute;
            bottom: -100px;
            left: -100px;
            width: 500px;
            height: 500px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500"><defs><radialGradient id="roseB1"><stop offset="0%25" stop-color="%23B8D9F0"/><stop offset="100%25" stop-color="%237BA8D1"/></radialGradient><radialGradient id="roseB2"><stop offset="0%25" stop-color="%239CC5E8"/><stop offset="100%25" stop-color="%236690B8"/></radialGradient></defs><g opacity="0.6"><ellipse cx="180" cy="330" rx="52" ry="57" fill="url(%23roseB1)"/><ellipse cx="160" cy="320" rx="40" ry="45" fill="url(%23roseB2)"/><ellipse cx="200" cy="320" rx="45" ry="50" fill="url(%23roseB1)"/><ellipse cx="175" cy="350" rx="38" ry="43" fill="url(%23roseB2)"/><ellipse cx="190" cy="335" rx="32" ry="37" fill="url(%23roseB1)" opacity="0.8"/></g><g opacity="0.55"><ellipse cx="130" cy="280" rx="55" ry="60" fill="url(%23roseB2)"/><ellipse cx="110" cy="290" rx="43" ry="48" fill="url(%23roseB1)"/><ellipse cx="145" cy="270" rx="38" ry="42" fill="url(%23roseB2)"/></g><g opacity="0.5"><ellipse cx="80" cy="340" rx="48" ry="53" fill="url(%23roseB1)"/><ellipse cx="90" cy="360" rx="40" ry="45" fill="url(%23roseB2)"/></g><g fill="%23BFA574" opacity="0.4"><ellipse cx="185" cy="360" rx="10" ry="43" transform="rotate(-28 185 360)"/><ellipse cx="165" cy="355" rx="9" ry="38" transform="rotate(18 165 355)"/><ellipse cx="135" cy="300" rx="11" ry="45" transform="rotate(25 135 300)"/><ellipse cx="115" cy="305" rx="9" ry="40" transform="rotate(-32 115 305)"/></g><g fill="%2388B076" opacity="0.35"><ellipse cx="180" cy="355" rx="14" ry="7" transform="rotate(32 180 355)"/><ellipse cx="170" cy="350" rx="12" ry="6" transform="rotate(-22 170 350)"/><ellipse cx="130" cy="295" rx="15" ry="7" transform="rotate(28 130 295)"/></g></svg>') no-repeat;
            background-size: contain;
            pointer-events: none;
        }

        .cover.hidden {
            transform: translateY(-100%);
        }

        .cover-content {
            text-align: center;
            color: white;
            padding: 20px;
        }

        .cover h1 {
            font-family: 'Great Vibes', cursive;
            font-size: 4em;
            margin-bottom: 20px;
            animation: fadeInDown 1s ease-in-out;
        }

        .cover p {
            font-size: 1.5em;
            margin-bottom: 30px;
            animation: fadeInUp 1s ease-in-out;
        }

        .open-btn {
            padding: 15px 40px;
            font-size: 1.2em;
            background: white;
            color: #667eea;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-weight: 500;
            transition: all 0.3s;
            animation: pulse 2s infinite;
        }

        .open-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        /* Main Container */
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            box-shadow: 0 0 50px rgba(0,0,0,0.1);
            position: relative;
        }

        /* Hero Section */
        .hero {
            position: relative;
            height: 100vh;
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .floral-decoration {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0.6;
            pointer-events: none;
        }

        .floral-top-right {
