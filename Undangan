    <script>
        // Open Invitation
        function openInvitation() {
            document.getElementById('cover').classList.add('hidden');
            playMusic();
        }

        // Music Player
        let isPlaying = false;
        const audio = document.getElementById('bgMusic');
        const musicBtn = document.getElementById('musicBtn');

        function toggleMusic() {
            if (isPlaying) {
                audio.pause();
                musicBtn.textContent = '🎵';
                musicBtn.classList.remove('playing');
            } else {
                audio.play();
                musicBtn.textContent = '🎶';
                musicBtn.classList.add('playing');
            }
            isPlaying = !isPlaying;
        }

        function playMusic() {
            audio.play();
            musicBtn.textContent = '🎶';
            musicBtn.classList.add('playing');
            isPlaying = true;
        }

        // Countdown Timer
        function updateCountdown() {
            const eventDate = new Date('2026-05-05T14:00:00').getTime();
            const now = new Date().getTime();
            const distance = eventDate - now;

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('days').textContent = days;
            document.getElementById('hours').textContent = hours;
            document.getElementById('minutes').textContent = minutes;
            document.getElementById('seconds').textContent = seconds;

            if (distance < 0) {
                document.getElementById('countdown').innerHTML = '<p style="font-size: 2em;">Acara telah berlangsung! 🎉</p>';
            }
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Copy Account Number
        function copyAccountNumber() {
            const accountNumber = document.getElementById('accountNumber').textContent;
            navigator.clipboard.writeText(accountNumber).then(() => {
                const successMsg = document.getElementById('copySuccess');
                successMsg.style.display = 'block';
                setTimeout(() => {
                    successMsg.style.display = 'none';
                }, 3000);
            });
        }

        // Comments System
        let comments = [];
        const STORAGE_KEY = 'engagementComments_DedeDwi2026';

        function loadComments() {
            const savedComments = localStorage.getItem(STORAGE_KEY);
            if (savedComments) {
                try {
                    comments = JSON.parse(savedComments);
                    displayComments();
                } catch (e) {
                    comments = [];
                }
            }
        }

        function submitComment() {
            const name = document.getElementById('commentName').value.trim();
            const attendance = document.getElementById('commentAttendance').value;
            const message = document.getElementById('commentMessage').value.trim();

            if (!name || !attendance || !message) {
                alert('Mohon lengkapi semua field');
                return;
            }

            const comment = {
                id: Date.now() + Math.random().toString(36).substr(2, 9),
                name: name,
                attendance: attendance,
                message: message,
                timestamp: new Date().toISOString(),
                displayTime: new Date().toLocaleString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                })
            };

            comments.unshift(comment);
            
            // Save to localStorage - once saved, cannot be deleted
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(comments));
            } catch (e) {
                alert('Gagal menyimpan ucapan. Mungkin storage penuh.');
                comments.shift(); // Remove the comment we just added
                return;
            }
            
            // Clear form
            document.getElementById('commentName').value = '';
            document.getElementById('commentAttendance').value = '';
            document.getElementById('commentMessage').value = '';

            displayComments();
            
            // Show success message
            alert('Terima kasih atas ucapan dan doanya! 💙');
        }

        function displayComments() {
            const commentsList = document.getElementById('commentsList');
            
            if (comments.length === 0) {
                commentsList.innerHTML = '<div class="no-comments">Belum ada ucapan. Jadilah yang pertama! 💙</div>';
                return;
            }

            let html = '';
            comments.forEach(comment => {
                html += `
                    <div class="comment-item">
                        <div class="comment-header">
                            <span class="comment-author">${escapeHtml(comment.name)}</span>
                            <span class="comment-attendance">${comment.attendance}</span>
                        </div>
                        <div class="comment-time">${comment.displayTime}</div>
                        <div class="comment-text">${escapeHtml(comment.message)}</div>
                    </div>
                `;
            });
            
            commentsList.innerHTML = html;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Load comments on page load
        loadComments();

        // RSVP Form Submission
        function submitRSVP(event) {
            event.preventDefault();
            const name = document.getElementById('name').value;
            const attendance = document.getElementById('attendance').value;
            const guests = document.getElementById('guests').value;
            const message = document.getElementById('message').value;

            // Create WhatsApp message
            const whatsappMessage = `Halo, saya ${name}.\n\nKonfirmasi Kehadiran: ${attendance}\nJumlah Tamu: ${guests}\n\nUcapan & Doa:\n${message}`;
            const whatsappURL = `https://wa.me/62081524399994?text=${encodeURIComponent(whatsappMessage)}`;

            // Open WhatsApp
            window.open(whatsappURL, '_blank');

            // Reset form
            event.target.reset();
            alert('Terima kasih! Anda akan diarahkan ke WhatsApp untuk mengirim konfirmasi.');
        }

        // Scroll Animation
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'fadeIn 1s ease-in-out';
                }
            });
        });

        document.querySelectorAll('section').forEach(section => {
            observer.observe(section);
        });
    </script>
</body>
</html>
