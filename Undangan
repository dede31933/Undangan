            background-size: contain;
        }

        .floral-bottom-left {
            position: absolute;
            bottom: -50px;
            left: -50px;
            width: 450px;
            height: 450px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 450 450"><defs><radialGradient id="rose1b"><stop offset="0%25" stop-color="%239CC5E8"/><stop offset="100%25" stop-color="%236B9BD1"/></radialGradient><radialGradient id="rose2b"><stop offset="0%25" stop-color="%23B8D9F0"/><stop offset="100%25" stop-color="%2387CEEB"/></radialGradient><radialGradient id="rose3b"><stop offset="0%25" stop-color="%2387CEEB"/><stop offset="100%25" stop-color="%235C9FBE"/></radialGradient></defs><g opacity="0.8"><ellipse cx="120" cy="320" rx="42" ry="47" fill="url(%23rose1b)"/><ellipse cx="100" cy="310" rx="32" ry="37" fill="url(%23rose2b)"/><ellipse cx="140" cy="310" rx="38" ry="42" fill="url(%23rose1b)"/><ellipse cx="110" cy="335" rx="35" ry="40" fill="url(%23rose3b)"/><ellipse cx="130" cy="325" rx="28" ry="32" fill="url(%23rose2b)" opacity="0.7"/></g><g opacity="0.75"><ellipse cx="180" cy="270" rx="48" ry="52" fill="url(%23rose2b)"/><ellipse cx="160" cy="260" rx="36" ry="40" fill="url(%23rose1b)"/><ellipse cx="200" cy="265" rx="33" ry="38" fill="url(%23rose3b)"/><ellipse cx="175" cy="285" rx="30" ry="35" fill="url(%23rose2b)" opacity="0.8"/></g><g opacity="0.7"><ellipse cx="240" cy="220" rx="40" ry="45" fill="url(%23rose3b)"/><ellipse cx="220" cy="210" rx="34" ry="38" fill="url(%23rose1b)"/><ellipse cx="250" cy="230" rx="28" ry="32" fill="url(%23rose2b)"/></g><g fill="%23C9A86A" opacity="0.5"><ellipse cx="125" cy="345" rx="8" ry="34" transform="rotate(-25 125 345)"/><ellipse cx="105" cy="340" rx="7" ry="30" transform="rotate(15 105 340)"/><ellipse cx="185" cy="295" rx="9" ry="36" transform="rotate(20 185 295)"/><ellipse cx="165" cy="290" rx="7" ry="31" transform="rotate(-30 165 290)"/><ellipse cx="235" cy="245" rx="8" ry="33" transform="rotate(-15 235 245)"/></g><g fill="%2387A96B" opacity="0.4"><ellipse cx="115" cy="340" rx="12" ry="6" transform="rotate(30 115 340)"/><ellipse cx="135" cy="335" rx="10" ry="5" transform="rotate(-20 135 335)"/><ellipse cx="175" cy="290" rx="13" ry="6" transform="rotate(25 175 290)"/><ellipse cx="195" cy="285" rx="11" ry="5" transform="rotate(-35 195 285)"/></g></svg>') no-repeat;
            background-size: contain;
        }

        /* Additional floral decorations for other sections */
        .section-flower-top {
            position: absolute;
            top: 0;
            right: 20px;
            width: 200px;
            height: 200px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><g fill="%239CC5E8"><circle cx="100" cy="80" r="25" opacity="0.6"/><circle cx="120" cy="70" r="20" opacity="0.5"/><circle cx="110" cy="95" r="18" opacity="0.7"/></g><g fill="%23B8D9F0"><circle cx="85" cy="90" r="22" opacity="0.6"/><circle cx="95" cy="75" r="15" opacity="0.5"/></g></svg>') no-repeat;
            background-size: contain;
            opacity: 0.5;
            pointer-events: none;
        }

        .section-flower-bottom {
            position: absolute;
            bottom: 0;
            left: 20px;
            width: 180px;
            height: 180px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180"><g fill="%2387CEEB"><circle cx="90" cy="100" r="25" opacity="0.6"/><circle cx="70" cy="110" r="20" opacity="0.5"/><circle cx="100" cy="115" r="18" opacity="0.7"/></g><g fill="%239CC5E8"><circle cx="110" cy="95" r="22" opacity="0.6"/><circle cx="85" cy="85" r="15" opacity="0.5"/></g></svg>') no-repeat;
            background-size: contain;
            opacity: 0.5;
            pointer-events: none;
        }

        .hero-content {
            text-align: center;
            z-index: 10;
            padding: 20px;
            animation: fadeIn 1.5s ease-in-out;
        }

        .hero-content h2 {
            font-family: 'Great Vibes', cursive;
            font-size: 3.5em;
            color: #5c6bc0;
            margin-bottom: 30px;
        }

        .bismillah {
            font-size: 1.5em;
            color: #666;
            margin-bottom: 20px;
            font-style: italic;
        }

        .invitation-text {
            font-size: 1.1em;
            color: #555;
            line-height: 1.8;
            margin-bottom: 40px;
            padding: 0 20px;
        }

        .couple-names {
            font-size: 3em;
            font-family: 'Great Vibes', cursive;
            color: #5c6bc0;
            margin: 30px 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .ampersand {
            font-size: 0.8em;
            display: block;
            margin: 20px 0;
        }

        /* Event Details */
        .event-details {
            padding: 60px 30px;
            background: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .event-details::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 280px;
            height: 280px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280"><defs><radialGradient id="ed1"><stop offset="0%25" stop-color="%23B8D9F0"/><stop offset="100%25" stop-color="%2387CEEB"/></radialGradient></defs><g opacity="0.5"><ellipse cx="200" cy="90" rx="38" ry="42" fill="url(%23ed1)"/><ellipse cx="220" cy="80" rx="30" ry="34" fill="%239CC5E8"/><ellipse cx="230" cy="105" rx="32" ry="36" fill="url(%23ed1)"/><ellipse cx="180" cy="105" rx="28" ry="32" fill="%2387CEEB" opacity="0.7"/></g><g fill="%23C9A86A" opacity="0.4"><ellipse cx="210" cy="115" rx="7" ry="30" transform="rotate(25 210 115)"/><ellipse cx="190" cy="120" rx="6" ry="26" transform="rotate(-20 190 120)"/></g></svg>') no-repeat;
            background-size: contain;
            pointer-events: none;
        }

        .event-details::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 250px;
            height: 250px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 250 250"><defs><radialGradient id="ed2"><stop offset="0%25" stop-color="%239CC5E8"/><stop offset="100%25" stop-color="%236B9BD1"/></radialGradient></defs><g opacity="0.5"><ellipse cx="70" cy="180" rx="36" ry="40" fill="url(%23ed2)"/><ellipse cx="90" cy="170" rx="28" ry="32" fill="%2387CEEB"/><ellipse cx="60" cy="165" rx="30" ry="34" fill="url(%23ed2)"/></g><g fill="%23BFA574" opacity="0.4"><ellipse cx="75" cy="195" rx="7" ry="28" transform="rotate(-25 75 195)"/></g></svg>') no-repeat;
            background-size: contain;
            pointer-events: none;
        }

        .event-details h3 {
            font-family: 'Great Vibes', cursive;
            font-size: 2.5em;
            color: #5c6bc0;
            margin-bottom: 40px;
        }

        .detail-box {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .detail-icon {
            font-size: 2em;
            margin-bottom: 15px;
        }

        .detail-box h4 {
            font-size: 1.5em;
            color: #5c6bc0;
            margin-bottom: 15px;
        }

        .detail-box p {
            font-size: 1.1em;
            color: #666;
            line-height: 1.6;
        }

        /* Countdown Timer */
        .countdown {
            padding: 60px 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-align: center;
        }

        .countdown h3 {
            font-family: 'Great Vibes', cursive;
            font-size: 2.5em;
            margin-bottom: 40px;
        }

        .countdown-timer {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .countdown-item {
            background: rgba(255,255,255,0.2);
            padding: 20px;
            border-radius: 15px;
            min-width: 100px;
            backdrop-filter: blur(10px);
        }

        .countdown-value {
            font-size: 3em;
            font-weight: 600;
            display: block;
        }

        .countdown-label {
            font-size: 1em;
            opacity: 0.9;
        }

        /* Map Section */
        .map-section {
            padding: 60px 30px;
            background: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .map-section::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 20px;
            width: 220px;
            height: 220px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 220"><defs><radialGradient id="map1"><stop offset="0%25" stop-color="%23B8D9F0"/><stop offset="100%25" stop-color="%238BB8D9"/></radialGradient></defs><g opacity="0.45"><ellipse cx="80" cy="80" rx="32" ry="36" fill="url(%23map1)"/><ellipse cx="100" cy="70" rx="26" ry="30" fill="%239CC5E8"/><ellipse cx="70" cy="100" rx="28" ry="32" fill="url(%23map1)"/></g></svg>') no-repeat;
            background-size: contain;
            pointer-events: none;
        }

        .map-section::after {
            content: '';
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 240px;
            height: 240px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240"><defs><radialGradient id="map2"><stop offset="0%25" stop-color="%2387CEEB"/><stop offset="100%25" stop-color="%235C9FBE"/></radialGradient></defs><g opacity="0.45"><ellipse cx="160" cy="160" rx="35" ry="39" fill="url(%23map2)"/><ellipse cx="180" cy="150" rx="28" ry="32" fill="%239CC5E8"/><ellipse cx="150" cy="180" rx="30" ry="34" fill="url(%23map2)"/></g></svg>') no-repeat;
            background-size: contain;
            pointer-events: none;
        }

        .map-section h3 {
            font-family: 'Great Vibes', cursive;
            font-size: 2.5em;
            color: #5c6bc0;
            margin-bottom: 20px;
        }

        .address {
            font-size: 1.1em;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.8;
        }

        .map-btn {
            display: inline-block;
            padding: 15px 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-size: 1.1em;
            font-family: 'Montserrat', sans-serif;
            transition: all 0.3s;
            margin-top: 20px;
        }

        .map-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

        /* Gift Section */
        .gift-section {
            padding: 60px 30px;
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .gift-section::before {
            content: '';
            position: absolute;
            top: 20px;
            right: 20px;
